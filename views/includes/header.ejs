<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <style>
        /* navbar  */
        @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:ital,wght@0,100..700;1,100..700&family=Varela+Round&display=swap');
       
        body{
            position: relative;
        } 
                
        nav{
        padding: 5px 10px;
        display: flex;
        align-items: center;
        justify-content: space-between; 
        border-bottom: 1px solid rgb(180, 179, 179);
        }


        nav img{
        width: 40px;
        }

        nav a{
        text-decoration: none;
        color: rgb(34, 33, 33);
        font-size: 17px;
        margin-left: 20px;
        font-family: "Varela Round", "sans-serif";
        }

        header{
            position: sticky;
            top: 0px;
            background-color: white;
            z-index: 5;
        }

        .navlinks{
            display: flex;
            align-items: center;
        }

        .menuIcon{
            display: none;
            position: relative;
            z-index: 10;
        }

        .headerMenuIcon, .headerXIcon{
            font-size: 5vw;
        }

        .crossIcon{
            display: none;
            position: relative;
        }


        .listBox{
        background-color: rgb(240, 235, 240);
        width: 35vw;
        height: auto;
        aspect-ratio: 1/0.9;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        position: fixed;
        right: 0.5vw;
        top: 60px;
        z-index: 2;
        border-radius: 5px;
        padding: 1.3vw 1vw;
        box-shadow: 0px 5px 5px grey;
        display: none;
        }   

        .listBox a{
            margin-bottom: 5px;
            display: block;
            font-size: 3.5vw;
            padding: 0.5vw 0.8vw;
            border-radius: 0.5vw;
            margin-left: 0px;
        }

        .listBox a:hover{
            cursor: pointer;
            background-color:rgb(114, 111, 111);
            color: white;
        }

        /* Search Bar Style */
        .searchInput{
            width: 25vw;
            height: 25px;
            border-radius: 15px;
            border: 1px solid rgb(124, 123, 123);
            padding: 0.2vw 1.5vw;
            margin-left: 20px;
        }


        .searchBtn{
            background-color: #ff5a5f;
            width: 5.3vw;
            height: 32px;
            border: none;
            border-radius: 2vw;
            padding: 0.2vw 0vw;
        }
       
        .fa-magnifying-glass{
            font-size: 15px;
        }

        .searchBtn:hover{
            background-color: rgb(168, 3, 3);
            cursor: pointer;
            transition: ease-in-out;
            transition-duration: 0.3s;
        }
        /* Media Queries */
        
        @media ((min-width: 821px)){
            .crossIcon{
                display:none !important;
            }
            .menuIcon{
                display: none !important;
            }
            .listBox{
                display: none !important;
            }
        }
 
        @media ((min-width: 450px) and (max-width: 820px)){
            .menuIcon{
                display: inline-block;
            }
            .loginlinks{
                display: none;
            }
            .navlinks a{
                display: none;
            }
            nav img{
                width: 8vw;
            }
            .listBox{
                top: 7vw;
            }
            nav img{
                width: 8vw;
            }
            .headerMenuIcon, .headerXIcon{
                font-size: 4.5vw;
            } 
            
            .searchInput{
                width: 40vw;
                margin-left: 0px;
            }
            .searchBtn{
                width: 8vw;
                padding: 0vw 0vw;
            }
            .fa-magnifying-glass{
                font-size: 12px;
            }
        }

        @media ((max-width: 450px)){
            .menuIcon{
                display: inline-block;
            }
            .loginlinks{
                display: none;
            }
            .navlinks a{
                display: none;
            }
            nav img{
                width: 12vw;
            }
            .listBox{
                top: 16vw;
            }
            .headerMenuIcon, .headerXIcon{
                font-size: 7vw;
            }
            .searchInput{
                width: 50vw;
                margin-left: 0px;
            }
            .searchBtn{
                width: 8vw;
                border-radius: 5vw;
                padding: 0vw 0vw;
                height: 28px;
            }
            .fa-magnifying-glass{
                font-size: 11px;
            }
        }



    </style>
</head>
<body>
    <header>
        <nav>
            <div class="navlinks">
            <img src="https://avatars.githubusercontent.com/u/698437?s=200&v=4" alt="website logo">
            <a href="/listing">Explore</a> 
            </div>

            <!-- Search Bar -->
            <div>
                <input type="text" placeholder="Search destination" class="searchInput">
                <button class="searchBtn"><i class="fa-solid fa-magnifying-glass" style="color: white"></i></button>
            </div>

            <div class="loginlinks">
                <a href="/listing/new">Aribnb your home</a>
                <% if(!currUser) {%>
                    <a href="/signup"><b>Sign up</b></a>
                    <a href="/login"><b>Login</b></a>
                <% } %>
                
                <% if(currUser) { %>
                <a href="/logout"><b>Logout</b></a>
                <% } %>
            </div>

            <div class="menuIcon">
            <i class="fa-solid fa-bars  headerMenuIcon" style="color: black"></i>
            </div>

            <div class="crossIcon">
                <i class="fa-solid fa-xmark headerXIcon" style="color: black"></i>
                </div>

            <div class="listBox">
                <a href="/listing">Explore</a> 
                <a href="/listing/new">Airbnb your home</a>
                    <% if(!currUser) {%>
                        <a href="/signup"><b>Sign up</b></a>
                        <a href="/login"><b>Login</b></a>
                    <% } %>
                    
                    <% if(currUser) { %>
                    <a href="/logout"><b>Logout</b></a>
                    <% } %>
            </div>

        </nav>
    </header>
 
    <script>
        let menuIcon = document.getElementsByClassName("fa-bars")[0];
        let crossIcon = document.getElementsByClassName("crossIcon")[0];
        let listBox = document.getElementsByClassName("listBox")[0];
      
        menuIcon.addEventListener("click", () => {
            listBox.style.display="block";
            menuIcon.style.display="none";
            crossIcon.style.display="block";
        });

        crossIcon.addEventListener("click", ()=>{
            listBox.style.display="none";
            menuIcon.style.display="block";
            crossIcon.style.display="none";
        })
      </script>

      <!-- <script src="/js/searchListing.js"></script> -->
</body>
</html>

