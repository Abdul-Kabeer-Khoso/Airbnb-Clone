<%- include("../includes/header.ejs")%>

<%- include("../includes/flash.ejs")%>

<style>
    body{
        height: 100dvh;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }
    .formOuterBox{
        width: 100%;
        height: 70vh;
        display: flex;
        justify-content: center;
        align-items: center;
    }
    .formBox{
        width: 320px;
        height: auto;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    form, h1, label{
        font-family: "Varela Round", sans-serif;
    }

    h1{
        font-size: 3vw;
    }

    form{
        width: 100%;
    }

    input{
        width: 95%;
        height: 30px;
        border-radius: 3px;
        border: 1px solid black;
        padding: 4px 8px;
    }

    button{
        width: 80px;
        background-color: rgb(4, 33, 34);
        color: white;
        padding: 7px 12px;
        border-radius: 5px;
        border: none;
        margin-left: 40%;
        font-size: 19px;
    }

    button:hover{
        cursor: pointer;
    }
    .searchBtn, .searchInput{
            display: none;
    }

    /* Media Queries */
    @media ((min-width: 700px) and (max-width: 1000px)){
        h1{
            font-size: 4vw;
        }
    }

    @media ((min-width: 500px) and (max-width: 700px)){
        h1{
            font-size: 6vw;
        }
    }

    @media ((max-width: 500px)){
        h1{
            font-size: 8vw;
        }
        .formBox{
            width: 100vw;
        }
        form input{
            width: 80vw;
        }
        form{
            display: flex;
            flex-direction: column;
            align-items: center;
        }
        form button{
            margin-left: 0%;
            width: 25vw;

        }
    }

</style>

<div class="formOuterBox">
    <div class="formBox">
        <h1>LOGIN</h1>
    <form action="/login" method="POST">
        <label for="username">Username <br>
        <input type="text" name="username" required>
        </label>

        <br> <br>

        <label for="password">Password <br> 
        <input type="password" name="password" required>
        </label>

        <br> <br>

        <button>Login</button>
    </form>
    </div>
</div>


<%- include("../includes/footer.ejs") %>